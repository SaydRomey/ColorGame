# Sound Files
WAV_DIR		:= ./utils/wav
WAV_WELCOME	:= $(WAV_DIR)/welcome.wav
WAV_PUSHIT	:= $(WAV_DIR)/push.wav

pushit: ## push it to the limit
	@$(PLAY_SOUND) $(WAV_PUSHIT)

welcome: ## what can i say
	@$(PLAY_SOUND) $(WAV_WELCOME)

.PHONY: pushit welcome


