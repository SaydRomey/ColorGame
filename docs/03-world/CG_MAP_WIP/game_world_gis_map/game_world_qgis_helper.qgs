<!DOCTYPE qgis><qgis projectname="Game World GIS Map" version="3.34"><title>Game World GIS Map</title><projectlayers><maplayer type="vector" geometry="Polygon" name="regions"><datasource>./regions.geojson</datasource><provider>ogr</provider></maplayer><maplayer type="vector" geometry="Line" name="links"><datasource>./links.geojson</datasource><provider>ogr</provider></maplayer><maplayer type="vector" geometry="Point" name="landmarks"><datasource>./landmarks.geojson</datasource><provider>ogr</provider></maplayer><maplayer type="vector" geometry="Point" name="entities"><datasource>./entities.geojson</datasource><provider>ogr</provider></maplayer></projectlayers></qgis>